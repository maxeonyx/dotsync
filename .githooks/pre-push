#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

updates="$(cat)"

if [[ -z "$updates" ]]; then
    exit 0
fi

pushes_main=0
while IFS=' ' read -r _local_ref _local_oid remote_ref _remote_oid; do
    if [[ -z "${remote_ref:-}" ]]; then
        continue
    fi
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        pushes_main=1
        break
    fi
done <<<"$updates"

if [[ "$pushes_main" -eq 0 ]]; then
    exit 0
fi

# Only the version check runs here. Clippy and the ratchet are CI's job: running
# them again costs a minute on every push, and the ratchet cannot run from a hook
# at all, because git exports GIT_DIR and GIT_WORK_TREE into the test processes
# (https://github.com/maxeonyx/tdd-ratchet-rs/issues/4).
printf '%s\n' 'dotsync pre-push: validating main push version bump...'
python3 scripts/check_main_version_bump.py pre-push <<<"$updates"
